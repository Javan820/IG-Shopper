# Copy this file to `.env` and fill in the values from the app's .env.local.
# These never leave your machine — the worker connects directly to Supabase.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to 0 to watch the browser (useful for debugging / first run).
HEADLESS=1

# Speed vs. safety. Average seconds to pause between Instagram requests (each
# jitters ±40%). Lower = faster but more likely to get rate-limited; raise these
# if jobs start returning 0 found or errors. Defaults shown.
SEARCH_DELAY=1.1
ENRICH_DELAY=0.85
